# Website-URL (voor SEO, sitemap, Open Graph). Gebruik je echte domein op Vercel.
NEXT_PUBLIC_SITE_URL=https://zorgjustintime.nl

# Resend – e-mail voor het contactformulier
# Maak een account op https://resend.com en maak een API key aan.
RESEND_API_KEY=re_xxxxxxxxxxxx

# Optioneel: ander e-mailadres waar berichten naartoe gaan (standaard: zorgjustintime@hotmail.com)
# CONTACT_EMAIL_TO=zorgjustintime@hotmail.com

# Optioneel: afzender. Op het gratis Resend-plan kun je "onboarding@resend.dev" gebruiken.
# Na domeinverificatie kun je bijv. "Zorg Just In Time <contact@jouwdomein.nl>" gebruiken.
# RESEND_FROM="Zorg Just In Time <onboarding@resend.dev>"
